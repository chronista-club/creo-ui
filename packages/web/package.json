{
  "name": "@chronista-club/creo-ui",
  "version": "0.30.0",
  "description": "creo-ui — Web package (design tokens + components.css + Solid shell/control primitives)",
  "type": "module",
  "main": "./dist/shells/index.js",
  "module": "./dist/shells/index.js",
  "types": "./dist/shells/index.d.ts",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./token-shim.css": "./dist/token-shim.css",
    "./tokens.js": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./shells": {
      "types": "./dist/shells/index.d.ts",
      "import": "./dist/shells/index.js"
    },
    "./shells/index.css": "./dist/shells/index.css",
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chronista-club/creo-ui.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/chronista-club/creo-ui/issues"
  },
  "homepage": "https://github.com/chronista-club/creo-ui#readme",
  "keywords": [
    "design-system",
    "css-custom-properties",
    "design-tokens",
    "solid-js",
    "layout-primitives",
    "creo-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run --cwd ../.. build:web",
    "build:js": "vite build",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.15",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.14"
  },
  "license": "Apache-2.0"
}
