{
  "name": "creo-ui-vision",
  "version": "0.1.0",
  "description": "creo-ui — Webcam motion capture (MediaPipe Tasks wrapper)。 Hand pinch / head pose / face mesh / gesture を Solid signals として expose。 docs/design/vision-input.md の reference 実装。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./mediapipe": {
      "types": "./dist/mediapipe.d.ts",
      "import": "./dist/mediapipe.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chronista-club/creo-ui.git",
    "directory": "packages/vision"
  },
  "bugs": {
    "url": "https://github.com/chronista-club/creo-ui/issues"
  },
  "homepage": "https://github.com/chronista-club/creo-ui#readme",
  "keywords": [
    "creo-ui",
    "vision-input",
    "webcam",
    "motion-capture",
    "mediapipe",
    "gesture",
    "spatial-ui",
    "solid-js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "bun test src/",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "@mediapipe/tasks-vision": "^0.10.0 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "solid-js": "^1.9.15",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.14"
  },
  "license": "Apache-2.0"
}
