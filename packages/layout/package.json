{
  "name": "@chronista-club/creo-ui-layout",
  "version": "0.1.0",
  "description": "creo-ui — Layout Engine（attention 連続場 + 構造 + scrub）。core は純 calculation（DOM 依存ゼロ）、/solid が SolidJS reference 実装（LE-P1）。package 名は仮称（design doc OQ-5）",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/chronista-club/creo-ui.git",
    "directory": "packages/layout"
  },
  "scripts": {
    "build": "vite build",
    "test": "bun test src",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vite-plugin-solid": "^2.10.0"
  },
  "license": "Apache-2.0"
}
