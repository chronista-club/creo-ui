{
  "name": "@chronista-club/creo-ui-layout",
  "version": "0.3.0",
  "description": "creo-ui — Layout Engine（attention 連続場 + 構造 + scrub）。core は純 calculation（DOM 依存ゼロ）、/solid が SolidJS reference 実装。設計 SSOT: docs/design/layout-engine.md（LE-1〜LE-20）",
  "type": "module",
  "keywords": [
    "creo-ui",
    "layout-engine",
    "attention-field",
    "tiling",
    "scrub",
    "design-system",
    "solid-js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chronista-club/creo-ui.git",
    "directory": "packages/layout"
  },
  "scripts": {
    "build": "vite build",
    "test": "bun test src",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.15",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.14"
  },
  "license": "Apache-2.0"
}
