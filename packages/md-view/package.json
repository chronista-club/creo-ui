{
  "name": "creo-ui-md-view",
  "version": "0.1.0",
  "description": "creo-ui — Markdown renderer (SolidJS) consuming creo-views/md (WASM-backed mdast parser)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chronista-club/creo-ui.git",
    "directory": "packages/md-view"
  },
  "bugs": {
    "url": "https://github.com/chronista-club/creo-ui/issues"
  },
  "homepage": "https://github.com/chronista-club/creo-ui#readme",
  "keywords": [
    "creo-ui",
    "markdown",
    "solid-js",
    "mdast",
    "renderer",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && cp src/styles.css dist/styles.css",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "creo-views": "file:../../../creo-views"
  },
  "devDependencies": {
    "solid-js": "^1.9.15",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.14"
  },
  "license": "Apache-2.0"
}
